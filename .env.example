AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=
AZURE_ML_COMPUTE=
AZURE_STORAGE_ACCOUNT=

# Required for model calls.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
ANSWER_DEPLOYMENT=
JUDGE_DEPLOYMENT=
EMBEDDING_DEPLOYMENT=

# Store name used by the QA runner. The runner creates this Foundry Memory store if it does not exist.
MEMORY_STORE_NAME=memorybench_live_qa

# Dataset
# DATASET: longmemeval, locomo, or statebench
# DATASET_PERCENT: percent of the selected dataset to run, greater than 0 and up to 100
DATASET=longmemeval
DATASET_PERCENT=1
DATASET_VERSION=1
AML_ENVIRONMENT_VERSION=2
